# Copy to .env. С ./dev.sh up: DB_HOST=db, REDIS_HOST=redis, ELASTICSEARCH_HOST=elasticsearch:9200, LEGACY_DB_HOST=legacy_db

# Application
APP_NAME=THEINS3_BACKEND
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# URL
APP_URL=http://localhost:3000
STORAGE_URL=http://localhost:3000/storage

# Nova
NOVA_LICENSE_KEY=
NOVA_PATH=/admin

# Frontend (Next ISR / revalidation, ссылки на фронт в контенте и фидах)
FRONTEND_URL=http://localhost:3001
FRONTEND_REVALIDATE_URL=http://nginx/api/revalidate
FRONTEND_REVALIDATE_SECRET=
FRONTEND_REVALIDATE_TIMEOUT=10

# Locale (Nova / API)
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Database
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=theins
DB_USERNAME=theins
DB_PASSWORD=
DB_CHARSET=utf8

# Redis (просмотры, курсы, ProcessViewCounts)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=

# Elasticsearch (Scout на Post, поиск API)
SCOUT_DRIVER=elasticsearch
ELASTICSEARCH_HOST=127.0.0.1:9200

# Mailchimp (API newsletter)
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
MAILCHIMP_LIST_RU=
MAILCHIMP_LIST_EN=

# Google reCAPTCHA (подписка на рассылку)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Cache & filesystem (Cache:: в фидах, импорте, preview-токенах; Storage — public disk)
CACHE_STORE=database
CACHE_PREFIX=
FILESYSTEM_DISK=local

# Legacy Database (импорты artisan, не HTTP)
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=5432
LEGACY_DB_DATABASE=theins_legacy
LEGACY_DB_USERNAME=theins
LEGACY_DB_PASSWORD=
LEGACY_DB_CHARSET=utf8

# Session (глобальный StartSession, локаль в сессии, Nova)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Logging
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Other — в рантайме приложения сейчас не задействовано (оставьте при включении фичи)
# -----------------------------------------------------------------------------
# Vite: @vite только в welcome.blade.php, маршрута нет; Nova — Mix, не этот билд.

VITE_APP_NAME="${APP_NAME}"
PHP_CLI_SERVER_WORKERS=4
APP_FAKER_LOCALE=en_US
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
