{
    "name": "medov/regions-map-editor",
    "description": "A Laravel Nova field for regions_map content blocks.",
    "keywords": [
        "laravel",
        "nova"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Medov\\RegionsMapEditor\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Medov\\RegionsMapEditor\\FieldServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
